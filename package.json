{
  "name": "audit-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:all": "concurrently -n frontend,backend -c cyan,green \"npm run dev\" \"npm run dev:backend\"",
    "build": "next build",
    "build:backend": "npm --prefix backend run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.18",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "prisma": "^6.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "@prisma/client@6.16.3": true,
    "@prisma/engines@6.16.3": true,
    "prisma@6.16.3": true,
    "esbuild@0.21.5": true
  }
}
